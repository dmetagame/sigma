# Robinhood Chain testnet — copy to .env.local and fill in
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
RH_TESTNET_CHAIN_ID=46630
RH_TESTNET_EXPLORER=https://explorer.testnet.chain.robinhood.com

# Deployer — DO NOT COMMIT. Use an existing key with funds, or generate fresh via `cast wallet new`.
DEPLOYER_PRIVATE_KEY=

# Sigma Pilot agent
ANTHROPIC_API_KEY=

# Optional: WalletConnect / RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
