# Robinhood Chain testnet
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
RH_TESTNET_CHAIN_ID=46630
RH_TESTNET_EXPLORER=https://explorer.testnet.chain.robinhood.com

# Deployer — DO NOT COMMIT. Funds testnet contract deployments.
DEPLOYER_PRIVATE_KEY=

# Pilot — DO NOT COMMIT. The agent's own EOA. Registered as `agent` on each
# user's Strategist Policy. Separate from DEPLOYER for blast-radius control.
PILOT_PRIVATE_KEY=

# LLM provider for the Pilot agent. Set ONE of the two API keys below.
# Provider auto-selects based on which key is present; PILOT_PROVIDER overrides.
#
#   PILOT_PROVIDER=google      → Gemini 2.0 Flash (FREE tier — recommended)
#   PILOT_PROVIDER=anthropic   → Claude Sonnet 4.6 (paid, more capable reasoning)
PILOT_PROVIDER=google

# Google AI Studio — free at https://aistudio.google.com/apikey
# 15 RPM, 1500 RPD, 1M TPM on Gemini 2.0 Flash, no credit card.
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic — paid. Leave blank if using Gemini.
ANTHROPIC_API_KEY=

# Optional override; defaults: gemini-2.5-flash (google) or claude-sonnet-4-6 (anthropic).
PILOT_MODEL=

# Optional regime override for demo: calm | volatile | stressed
MARKET_REGIME=

# -- Real Robinhood Chain testnet addresses (auto-discovered via Blockscout API) --
# Override only if you want to test against alternative tokens.
USDC_ADDR=0xAc80194dc1aE8eF52df73e7e1864fB3C62290fe0
STOCK_TSLA_ADDR=0xC9f9c86933092BbbfFF3CCb4b105A4A94bf3Bd4E
STOCK_AMD_ADDR=0x71178BAc73cBeb415514eB542a8995b82669778d
STOCK_AMZN_ADDR=0x5884aD2f920c162CFBbACc88C9C51AA75eC09E02
STOCK_NFLX_ADDR=0x3b8262A63d25f0477c4DDE23F83cfe22Cb768C93
STOCK_PLTR_ADDR=0x1FBE1a0e43594b3455993B5dE5Fd0A7A266298d0

# Deployed Sigma contract addresses — written by ./scripts/deploy.sh
SIGMA_CORE_ADDR=
SIGMA_VAULT_ADDR=
SIGMA_STRATEGIST_ADDR=

# Optional: WalletConnect / RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
