{
  "name": "sigma",
  "private": true,
  "version": "0.0.0",
  "description": "On-chain risk engine in Stylus for tokenized equity collateral on Robinhood Chain.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @sigma/web dev",
    "build": "pnpm -r build",
    "contracts:build": "pnpm --filter @sigma/contracts build",
    "core:check": "cd core && cargo stylus check --endpoint https://rpc.testnet.chain.robinhood.com",
    "verify:deployment": "./scripts/verify-deployment.sh",
    "benchmark:gas": "./scripts/benchmark-gas.sh"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.15",
      "viem>ws": "8.20.1",
      "@metamask/sdk>uuid": "11.1.1",
      "@metamask/sdk-communication-layer>uuid": "11.1.1",
      "@metamask/utils>uuid": "11.1.1"
    }
  }
}
